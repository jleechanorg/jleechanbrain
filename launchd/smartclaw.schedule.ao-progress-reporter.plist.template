<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.smartclaw.schedule.ao-progress-reporter</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <!--
          CRITICAL: launchd does NOT source ~/.bashrc, so the user login PATH
          (which includes nvm: ${HOME}/.nvm/versions/node/v22.22.0/bin)
          is NOT visible here. Without nvm on PATH, the `ao` CLI is missing
          and fetch_ao_sessions() silently returns an empty array,
          causing every 30-min tick to post the lying
          "AO Progress Report — no active sessions detected" message even when
          many sessions are alive.

          launchd-env-wrapper.sh sources ~/.bash_profile, then ~/.bashrc, then
          exports the user PATH, so the `ao`, `jq`, `gh`, etc. binaries all
          resolve correctly.
          Verified 2026-06-27: 22 sessions were visible from the wrapper PATH
          but invisible to the launchd-inherited PATH.
        -->
        <string>${HOME}/.smartclaw/scripts/launchd-env-wrapper.sh</string>
        <string>${HOME}/.smartclaw/scripts/ao-progress-reporter.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/jleechan</string>
        <!--
          Belt-and-suspenders PATH in case the wrapper itself fails. Includes
          nvm so the `ao` binary resolves even if the wrapper source chain
          breaks. Audit 2026-06-27: previously the plist listed only
          /opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin — `ao` was invisible
          and the report lied every 30 min for the entire day.
        -->
        <key>PATH</key>
        <string>${HOME}/.nvm/versions/node/v22.22.0/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>SLACK_BOT_TOKEN</key>
        <string>@SLACK_BOT_TOKEN@</string>
        <key>AOPR_SLACK_THREAD_TS</key>
        <string>1775197044.035089</string>
    </dict>

    <key>StartInterval</key>
    <integer>1800</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>${HOME}/.smartclaw/logs/ao-progress-reporter.log</string>

    <key>StandardErrorPath</key>
    <string>${HOME}/.smartclaw/logs/ao-progress-reporter.err</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
