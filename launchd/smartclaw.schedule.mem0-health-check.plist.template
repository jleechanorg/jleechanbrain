<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.smartclaw.schedule.mem0-health-check</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>@HOME@/.smartclaw/scripts/mem0_health_check_launchd.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>@HOME@</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:${HOME}/.local/orch-venv/bin:${HOME}/.smartclaw/.venv/bin:/usr/bin:/bin</string>
        <key>GROQ_API_KEY</key>
        <string>@GROQ_API_KEY@</string>
    </dict>

    <!-- Every 6 hours. End-to-end run is 60-180s on cold cache, < 5s steady state. -->
    <key>StartInterval</key>
    <integer>21600</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>@HOME@/.smartclaw/logs/mem0-health-check.log</string>

    <key>StandardErrorPath</key>
    <string>@HOME@/.smartclaw/logs/mem0-health-check.error.log</string>

    <key>WorkingDirectory</key>
    <string>@HOME@/.smartclaw</string>
</dict>
</plist>
