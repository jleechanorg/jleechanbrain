<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.smartclaw.schedule.canary-periodic</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>@REPO_ROOT@/scripts/launchd-env-wrapper.sh</string>
        <string>/bin/bash</string>
        <string>@REPO_ROOT@/scripts/hermes-canary.sh</string>
        <string>--timeout</string>
        <string>30</string>
        <string>--json</string>
    </array>

<!-- DISABLED 2026-06-22 per user directive ("let's not do slack tests anymore").
         Canary-periodic was firing every 10min, posting
         "canary-<ts>-<pid> Respond with exactly: ack-<hex>" via xoxp user token to
         ${SLACK_CHANNEL_ID}, polluting #ai-slack-test. To re-enable: (1) get explicit
         approval from Jeffrey, (2) bump StartInterval to >=3600 (hourly),
         (3) move target channel off #ai-slack-test, (4) gate on a feature flag
         so deploy.sh does not re-enable it. -->
    <key>Disabled</key>
    <true/>

    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>@HOME@</string>
        <key>PATH</key>
        <string>@HERMES_EXTRA_PATH@@HOME@/.local/bin:@HOME@/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>TZ</key>
        <string>America/Los_Angeles</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>@HOME@/.smartclaw</string>

    <key>StandardOutPath</key>
    <string>@HOME@/.smartclaw/logs/canary-periodic.log</string>

    <key>StandardErrorPath</key>
    <string>@HOME@/.smartclaw/logs/canary-periodic.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>

    <key>ThrottleInterval</key>
    <integer>300</integer>
</dict>
</plist>
