<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.smartclaw.schedule.daily-repo-export</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>@REPO_ROOT@/scripts/auto-push-to-main.sh</string>
        <string>--repo</string>
        <string>@HOME@/llm_wiki:llm-wiki</string>
        <string>--repo</string>
        <string>@HOME@/roadmap:roadmap</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>20</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>@HOME@/.smartclaw/logs/scheduled-jobs/daily-repo-export.out.log</string>

    <key>StandardErrorPath</key>
    <string>@HOME@/.smartclaw/logs/scheduled-jobs/daily-repo-export.err.log</string>

    <key>WorkingDirectory</key>
    <string>@REPO_ROOT@</string>

    <key>ProcessType</key>
    <string>Background</string>

    <key>ThrottleInterval</key>
    <integer>1800</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>@HOME@</string>
        <key>PATH</key>
        <string>@HERMES_EXTRA_PATH@@HOME@/.bun/bin:@HOME@/.local/bin:@HOME@/bin:@HOME@/Library/pnpm:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>TZ</key>
        <string>America/Los_Angeles</string>
        <key>AO_GO_BIN</key>
        <string>@AO_GO_BIN@</string>
        <key>RUN_INTERVAL_SECS</key>
        <string>0</string>
        <key>AO_PRIMARY_HARNESS</key>
        <string>codex</string>
        <key>AO_FALLBACK_HARNESS</key>
        <string>claude-code</string>
    </dict>
</dict>
</plist>
