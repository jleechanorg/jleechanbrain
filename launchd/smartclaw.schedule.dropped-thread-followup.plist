<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.smartclaw.schedule.dropped-thread-followup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>${HOME}/.smartclaw/scripts/dropped-thread-followup.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/jleechan</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>SLACK_BOT_TOKEN</key>
        <string>@SLACK_BOT_TOKEN@</string>
    </dict>

    <key>StartInterval</key>
    <integer>1800</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>${HOME}/.smartclaw/logs/dropped-thread-followup.log</string>

    <key>StandardErrorPath</key>
    <string>${HOME}/.smartclaw/logs/dropped-thread-followup.err</string>

    <key>KeepAlive</key>
    <dict>
        <!-- 2026-07-04 fix: silent launchd death (last exit 0, log frozen 9h, no cron fires).
             SuccessfulExit=false makes launchd restart the job on any 0-exit termination,
             which is the symptom we saw. Without this, launchd treats a 0-exit silent
             finish as "successfully completed" and never schedules another tick. -->
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
