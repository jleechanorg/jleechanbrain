<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.smartclaw.schedule.slack-5b-leak-detector</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>@HOME@/.smartclaw/scripts/slack_5b_leak_detector.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>@HOME@</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>SLACK_USER_TOKEN</key>
        <string>@SLACK_USER_TOKEN@</string>
        <key>SLACK_5B_CHANNELS</key>
        <string>C0AH3RY3DK6 C0BA4MCBPFB ${SLACK_CHANNEL_ID} ${SLACK_CHANNEL_ID}</string>
        <key>SLACK_5B_ALERT_CHANNEL</key>
        <string>C0AJQ5M0A0Y</string>
    </dict>

    <key>StartInterval</key>
    <!-- Reduced from 300s (every 5 min) to 12h. The detector is a safety
         net for sub-class 5b/5e misroutes; it is QUIET ON SUCCESS (no
         stdout/stderr when clean), so a 12h cadence is enough to catch
         real leaks within one polling cycle without 288x/day log noise.
         Jeffrey (operator) confirmed 12h cadence is acceptable in the
         2026-06-23 "reduce frequency" thread. -->
    <integer>43200</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>@HERMES_HOME@/logs/scheduled-jobs/slack-5b-leak-detector.log</string>

    <key>StandardErrorPath</key>
    <string>@HERMES_HOME@/logs/scheduled-jobs/slack-5b-leak-detector.err</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
