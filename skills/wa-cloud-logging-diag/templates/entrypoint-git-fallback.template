# entrypoint-git-fallback.template
# Apply to: testing_mcp/infra/entrypoint.sh
# Purpose: when .git/ is absent from the runtime image, fall back to GIT_COMMIT env var
# so the exact-HEAD guard doesn't crash the whole daily cron.
#
# Verified pattern: 2026-08-13 investigation on the wa-daily-level-up-test-mr6dk run.
# Pair with the Dockerfile COPY fix in templates/dockerfile-test-runner-git-ref.template.

# In entrypoint.sh, locate the line that runs the test runner, and ADD the env var:
export GIT_COMMIT="${GIT_COMMIT:-${GIT_COMMIT_OVERRIDE:-}}"

